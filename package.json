{
    "name":  "site-creator-vinext-starter",
    "version":  "0.1.0",
    "private":  true,
    "engines":  {
                    "node":  "\u003e=22.16.0"
                },
    "scripts":  {
                    "dev":  "node server/run.mjs dev",
                    "build":  "vinext build",
                    "start":  "node server/run.mjs start",
                    "test":  "npm run build \u0026\u0026 node --test tests/rendered-html.test.mjs tests/domain.test.mjs tests/database.test.mjs tests/auth.test.mjs tests/family-schedule.test.mjs tests/staff-management.test.mjs tests/staffing-requirements.test.mjs tests/staffing-candidates.test.mjs",
                    "lint":  "eslint . --ignore-pattern dist --ignore-pattern .next",
                    "cf:typegen":  "wrangler types worker-configuration.d.ts --config wrangler.types.jsonc",
                    "db:generate":  "drizzle-kit generate",
                    "db:migrate":  "node db/cli.mjs migrate",
                    "db:seed":  "node db/cli.mjs seed",
                    "db:status":  "node db/cli.mjs status",
                    "db:backup":  "node db/cli.mjs backup",
                    "db:restore":  "node db/cli.mjs restore",
                    "dev:host":  "node server/run.mjs dev",
                    "dev:vinext":  "vinext dev",
                    "auth:dev-accounts":  "node db/auth-cli.mjs create",
                    "auth:dev-reset":  "node db/auth-cli.mjs reset"
                },
    "dependencies":  {
                         "drizzle-orm":  "0.45.2",
                         "exceljs":  "4.4.0",
                         "next":  "16.2.6",
                         "react":  "19.2.6",
                         "react-dom":  "19.2.6"
                     },
    "devDependencies":  {
                            "@cloudflare/vite-plugin":  "1.37.1",
                            "@tailwindcss/postcss":  "4.2.1",
                            "@types/node":  "22.19.19",
                            "@types/react":  "19.2.14",
                            "@types/react-dom":  "19.2.3",
                            "@vitejs/plugin-react":  "6.0.2",
                            "@vitejs/plugin-rsc":  "0.5.26",
                            "drizzle-kit":  "0.31.10",
                            "eslint":  "9.39.4",
                            "eslint-config-next":  "16.2.6",
                            "react-server-dom-webpack":  "19.2.6",
                            "tailwindcss":  "4.2.1",
                            "typescript":  "5.9.3",
                            "vinext":  "0.0.50",
                            "vite":  "8.0.13",
                            "wrangler":  "4.92.0"
                        },
    "overrides":  {
                      "exceljs@4.4.0":  {
                                             "uuid":  "11.1.1",
                                             "brace-expansion":  "1.1.18"
                                         }
                  },
    "type":  "module"
}
